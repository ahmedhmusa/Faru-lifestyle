{
  "name": "Faru Finance",
  "short_name": "Faru",
  "description": "Personal and small business finance tracker",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f6f8f4",
  "theme_color": "#102a2d",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "id": "./",
  "orientation": "portrait-primary",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "categories": [
    "finance",
    "productivity"
  ],
  "shortcuts": [
    {
      "name": "Savings",
      "url": "./#savings"
    },
    {
      "name": "Travel",
      "url": "./#travel"
    },
    {
      "name": "Add / view transactions",
      "url": "./#transactions"
    }
  ]
}
